            "id": "d5dr42990cljmith5i64",
            "labels": {},
            "log_group_id": "",
            "log_options": [],
            "name": "gateway2",
            "spec": "# The OpenAPI specification for Yandex Cloud API Gateway.\r\n# Фактически - роутер-маршрутизатор. В paths - хендлеры\r\n# \r\nopenapi: \"3.0.0\"\r\ninfo:\r\n  version: 1.0.0\r\n  title: Test API\r\npaths:\r\n  /:\r\n    get:\r\n      summary: Say hello\r\n      operationId: hello\r\n      parameters:\r\n        - name: us\r\n          in: query\r\n          description: User name to appear in greetings\r\n          required: false\r\n          schema:\r\n            type: string\r\n            default: 'every buddy'\r\n      responses:\r\n        '200':\r\n          description: Greeting\r\n          content:\r\n            'text/plain':\r\n              schema:\r\n                type: \"string\"\r\n      x-yc-apigateway-integration:\r\n        type: dummy\r\n        http_code: 200\r\n        http_headers:\r\n          'Content-Type': \"text/plain\"\r\n        content:\r\n          'text/plain': \"Hello, {us}!\\n\" # для задания имени user https://******.apigw.yandexcloud.net/hello?user=uname\r\n  /mlook:\r\n    get:\r\n      responses:\r\n        '200':\r\n          description: Greeting\r\n          content:\r\n            'text/plain':\r\n              schema:\r\n                type: \"string\"\r\n        '502':\r\n          description: Greeting\r\n          content:\r\n            'text/plain':\r\n              schema:\r\n                type: \"string\"\r\n                default: \"errorrrr \"\r\n      x-yc-apigateway-integration:\r\n        type: cloud-functions\r\n        service_account_id: aje7i7q94e8puqb3t8tb # SA для invoker\r\n        function_id: d4eu04kjsfksao6ncj57  # Code.Sender получение и вывод метрик на экран, без БД\r\n        http_code: 200\r\n        http_headers:\r\n          'Content-Type': \"text/plain\"\r\n        \r\n  /mwrite:\r\n    get:\r\n      responses:\r\n        '200':\r\n          description: Ok\r\n        '503':\r\n          description: not ok\r\n      x-yc-apigateway-integration:\r\n        type: cloud-functions\r\n        service_account_id: aje7i7q94e8puqb3t8tb # SA для invoker\r\n        function_id: d4ejkpr5gs86qfumrmq2  # dbaser.WriteMetrics\r\n  /mread:\r\n    get:\r\n      responses:\r\n        '200':\r\n          description: Ok\r\n        '503':\r\n          description: not ok\r\n      x-yc-apigateway-integration:\r\n        type: cloud-functions\r\n        service_account_id: aje7i7q94e8puqb3t8tb # SA для invoker\r\n        function_id: d4ensou7rhn72c9vqgom  # dbaser.ReadMetrics\r\n        \r\n  /update/{mname}/{mvalue}:\r\n    get:\r\n      parameters:\r\n        - name: mname\r\n          in: path\r\n          description: Metric Name\r\n          required: true\r\n          schema:\r\n            type: string\r\n        - name: mvalue\r\n          in: path\r\n          description: Metric value\r\n          required: true\r\n          schema:\r\n            type: number\r\n      responses:\r\n        '200':\r\n          description: Ok\r\n        '503':\r\n          description: not ok\r\n      x-yc-apigateway-integration:\r\n        type: cloud-functions\r\n        service_account_id: aje7i7q94e8puqb3t8tb # SA для invoker\r\n        function_id: d4eb4lq4sn6ekh81q4nl  # dbaser.PutMetric\r\n        context:\r\n          mname: '{mname}'\r\n          mvalue: '{mvalue}'\r\n        \r\n  /value/{mname}:\r\n    get:\r\n      parameters:\r\n        - name: mname\r\n          in: path\r\n          description: Metric Name\r\n          required: true\r\n          schema:\r\n            type: string\r\n      responses:\r\n        '200':\r\n          description: Ok\r\n        '502':\r\n          description: not ok\r\n          content:\r\n           'text/plain':\r\n              schema:\r\n                type: \"string\"\r\n                default: \"errorrrrrrrrrrrr \"    \r\n      x-yc-apigateway-integration:\r\n        type: cloud-functions\r\n        service_account_id: aje7i7q94e8puqb3t8tb # SA для invoker\r\n        function_id: d4ed8frd4da74lii3k9i  # dbaser.GetMetric\r\n        context:\r\n          mname: '{mname}'\r\n        \r\n",

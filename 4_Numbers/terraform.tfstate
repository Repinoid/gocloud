            "log_options": [],
            "name": "gateway2",
            "spec": "# The OpenAPI specification for Yandex Cloud API Gateway.\r\n# Фактически - роутер-маршрутизатор. В paths - хендлеры\r\n# \r\nopenapi: \"3.0.0\"\r\ninfo:\r\n  version: 1.0.0\r\n  title: Test API\r\npaths:\r\n  /:\r\n    get:\r\n      summary: Say hello\r\n      operationId: hello\r\n      parameters:\r\n        - name: us\r\n          in: query\r\n          description: User name to appear in greetings\r\n          required: false\r\n          schema:\r\n            type: string\r\n            default: 'every buddy'\r\n      responses:\r\n        '200':\r\n          description: Greeting\r\n          content:\r\n            'text/plain':\r\n              schema:\r\n                type: \"string\"\r\n      x-yc-apigateway-integration:\r\n        type: dummy\r\n        http_code: 200\r\n        http_headers:\r\n          'Content-Type': \"text/plain\"\r\n        content:\r\n          'text/plain': \"Hello, {us}!\\n\" # для задания имени user https://******.apigw.yandexcloud.net/hello?user=uname\r\n  /mlook:\r\n    get:\r\n#      summary: goim\r\n#      operationId: gofu\r\n      # parameters:\r\n      #   - name: user\r\n      #     in: query\r\n      #     description: User name to appear in greetings\r\n      #     required: false\r\n      #     schema:\r\n      #       type: string\r\n      #       default: 'world'\r\n      responses:\r\n        '200':\r\n          description: Greeting\r\n          content:\r\n            'text/plain':\r\n              schema:\r\n                type: \"string\"\r\n        '502':\r\n          description: Greeting\r\n          content:\r\n            'text/plain':\r\n              schema:\r\n                type: \"string\"\r\n                default: \"errorrrr \"\r\n      x-yc-apigateway-integration:\r\n        type: cloud-functions\r\n        service_account_id: aje69sg0q3rfkirm0rs8 # SA для invoker\r\n        function_id: d4enrb3kqvrcev6vha9p  # Code.Sender получение и вывод метрик на экран, без БД\r\n        http_code: 200\r\n        http_headers:\r\n          'Content-Type': \"text/plain\"\r\n        \r\n  /mwrite:\r\n    get:\r\n      responses:\r\n        '200':\r\n          description: Ok\r\n        '503':\r\n          description: not ok\r\n      x-yc-apigateway-integration:\r\n        type: cloud-functions\r\n        service_account_id: aje69sg0q3rfkirm0rs8 # SA для invoker\r\n        function_id: d4ebt950u9ftv4v7schu  # dbaser.WriteMetrics\r\n  /mread:\r\n    get:\r\n      responses:\r\n        '200':\r\n          description: Ok\r\n        '503':\r\n          description: not ok\r\n      x-yc-apigateway-integration:\r\n        type: cloud-functions\r\n        service_account_id: aje69sg0q3rfkirm0rs8 # SA для invoker\r\n        function_id: d4eg6vsa3hgjudhbv6u5  # dbaser.ReadMetrics\r\n        \r\n",
            "status": "active",
            "timeouts": null,
